/* Main.rcss */
body {
    margin: 0;
    padding: 0;
    background: #1a1a1a; /* 黒に近い背景 */
    font-family: Noto Sans JP;
    color: white;
}

#Main {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px;
}

h1 {
    font-size: 48px;
    margin-bottom: 40px;
    color: #eaeaea;
}