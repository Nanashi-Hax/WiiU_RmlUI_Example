/* Main.rcss */
body {
    margin: auto;
    padding: 0;
    width: 25%;
    height: 75%;
    background: #1a1a1a; /* 黒に近い背景 */
    font-family: "Noto Sans JP";
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center; /* 並び方向の中央 */
    align-items: center;     /* 直交方向の中央 */
    gap: 40dp;
}

label {
    font-size: 48dp;
    color: #eaeaea;
}

button {
    color: #eaeaea;
    font-size: 48dp;
    tab-index: auto;
    nav: auto;
}

button:focus {
    color: #88ff00;
}

#Buttons {
    display: flex;
    flex-direction: column;
    gap: 20dp;
}