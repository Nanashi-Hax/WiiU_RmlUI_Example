<!-- Main.rml -->
<rml>
    <head>
        <title>Menu</title>
        <link type="text/rcss" href="Main.rcss"/>
    </head>

    <body>
        <div id="Clock" data-model="ClockModel">
            <label>{{hour}}:{{minute}}:{{second}}</label>
        </div>
        <div id="Buttons">
            <input type="checkbox"/>
            <button id="0000">0000</button>
            <button id="0001">0001</button>
            <button id="0002">0002</button>
            <button id="0003">0003</button>
        </div>
    </body>
</rml>
